{
  "name": "dashboard",
  "version": "1.0.1",
  "description": "Local, interactive finance dashboard for CEO-level review of revenue and cash outflows from CSV and Excel exports.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --base ./",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "npm run build:desktop && electron .",
    "desktop:build": "npm run build:desktop && electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.cfoflightdeck.desktop",
    "productName": "CFO Flight Deck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "README.md",
      "ACCOUNTANT_TEST_GUIDE.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CFO Flight Deck"
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "read-excel-file": "^9.0.6"
  }
}
